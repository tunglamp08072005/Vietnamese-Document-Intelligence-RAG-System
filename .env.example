# Qdrant runs locally with persistent storage when QDRANT_URL is not set.
# For Docker Compose, set QDRANT_URL=http://qdrant:6333.
DATABASE_PATH=./data/app.db
QDRANT_PATH=./data/qdrant
QDRANT_COLLECTION=vietnamese_documents
EMBEDDING_MODEL=BAAI/bge-m3
# OCR for scanned PDFs requires Tesseract with Vietnamese (vie) and English (eng) language data.
OCR_LANGUAGE=vie+eng
OCR_DPI=250
# Optional: set true to load BAAI/bge-reranker-v2-m3 for cross-encoder reranking.
RERANKER_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
# Leave blank to auto-select an installed Ollama chat model; qwen-family models are preferred.
# Or set an exact installed model name, for example qwen2.5:7b.
OLLAMA_MODEL=
# Allow slow model loading and generation; the UI waits 60 seconds longer than this limit.
OLLAMA_TIMEOUT_SECONDS=600
# Must exceed OLLAMA_TIMEOUT_SECONDS; includes 60 seconds for API overhead by default.
API_QUERY_TIMEOUT_SECONDS=660
# Keep Ollama's model loaded between questions to reduce repeated cold starts.
OLLAMA_KEEP_ALIVE=10m
MAX_UPLOAD_MB=25
CHUNK_SIZE_CHARS=2000
CHUNK_OVERLAP_CHARS=300
EMBEDDING_BATCH_SIZE=8
INDEX_BATCH_SIZE=128
RETRIEVAL_CANDIDATE_COUNT=40
RETRIEVAL_TOP_K=8
